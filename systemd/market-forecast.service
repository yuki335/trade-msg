[Unit]
Description=Send market forecasts (FX / JP / US stocks) to Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/market-forecast
# instruments.yaml / コードを毎回 GitHub から反映（失敗しても直前の正常版で継続）
ExecStartPre=-/usr/bin/git -C /opt/market-forecast pull --ff-only --quiet
ExecStartPre=-/opt/market-forecast/venv/bin/pip install -q -r requirements.txt
ExecStart=/opt/market-forecast/venv/bin/python main.py
User=deploy
